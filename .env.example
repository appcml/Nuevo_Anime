# ============================================
# CONFIGURACIÓN DE FACEBOOK (OBLIGATORIO)
# ============================================

# ID de tu página de Facebook (Nuevo Anime)
# Ejemplo: 61582178771974
FB_PAGE_ID=tu_page_id_aqui

# Token de acceso de página de Facebook
# Obtener en: https://developers.facebook.com/tools/explorer/
FB_ACCESS_TOKEN=tu_token_aqui


# ============================================
# APIS DE NOTICIAS (OPCIONAL pero recomendado)
# ============================================

# API Key de NewsAPI.org
# Registro gratuito: https://newsapi.org/
NEWS_API_KEY=tu_api_key_aqui

# API Key de GNews.io  
# Registro gratuito: https://gnews.io/
GNEWS_API_KEY=tu_api_key_aqui


# ============================================
# CONFIGURACIÓN AVANZADA (OPCIONAL)
# ============================================

# Rutas de archivos de datos
HISTORIAL_PATH=data/historial_anime.json
ESTADO_PATH=data/estado_bot_anime.json
