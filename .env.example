# CONFIGURACIÓN DEL BOT DE ANIME
# Copia este archivo como .env y completa tus credenciales
# O configúralas como Secrets en GitHub (recomendado)

# Facebook (Obligatorio)
FB_PAGE_ID=TU_PAGE_ID_AQUI
FB_ACCESS_TOKEN=TU_ACCESS_TOKEN_AQUI

# Gemini AI (Recomendado - Gratuito)
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI

# News API (Opcional - para fuentes adicionales)
NEWS_API_KEY=TU_NEWS_API_KEY_AQUI

# Rutas de archivos (Opcional - ya configurado por defecto)
HISTORIAL_PATH=data/historial_anime.json
ESTADO_PATH=data/estado_bot_anime.json
